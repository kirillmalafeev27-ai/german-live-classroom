{
  "name": "german-live-classroom",
  "version": "1.1.0",
  "private": true,
  "description": "Teacher-gated realtime German lesson copilot for Zoom and browser sessions",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
